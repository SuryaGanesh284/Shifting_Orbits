# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/shifting_orbits

# Authentication Secrets
JWT_ACCESS_SECRET=sof_jwt_access_super_secret_key_2026_change_in_production
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_SECRET=sof_jwt_refresh_super_secret_key_2026_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# AI Service Configuration (gemini, openai, mock)
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
